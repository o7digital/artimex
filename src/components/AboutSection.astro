---
import { aboutContent } from '../data/about.js';

interface Props {
  lang: 'en' | 'es';
  productSections: Array<{ key: string; anchor: string }>;
}
const { lang, productSections } = Astro.props;
const c = aboutContent[lang];
const fresh = productSections.find(section => section.key === 'fresh');
const wholesale = productSections.find(section => section.key === 'wholesale');
---
<section class="about-section" id="about" aria-labelledby="about-title">
  <div class="about-intro">
    <div class="about-opening">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 id="about-title">{c.title}<em>{c.titleEm}</em></h2>
      <p class="about-lead">{c.introduction}</p>
      <div class="about-origin">
        <p class="eyebrow">{c.originEyebrow}</p>
        <h3>{c.originTitle}</h3>
        <p>{c.originText}</p>
      </div>
      <ul class="about-principles" role="list">{c.principles.map(principle => <li>{principle}</li>)}</ul>
    </div>
    <figure class="about-portrait">
      <picture>
        <source srcset="/images/original/artimex-bread-assortment.webp" type="image/webp" />
        <img src="/images/original/artimex-bread-assortment.jpg" alt={c.portraitAlt} width="800" height="868" loading="lazy" decoding="async" />
      </picture>
      <figcaption>{c.portraitCaption}</figcaption>
    </figure>
  </div>

  <div class="about-standard">
    <div class="about-standard-intro">
      <p class="eyebrow">{c.craftEyebrow}</p>
      <h3>{c.craftTitle}</h3>
      <div class="about-archive">
        <figure>
          <picture>
            <source srcset="/images/original/artimex-conchas-portrait.webp" type="image/webp" />
            <img src="/images/original/artimex-conchas-portrait.jpg" alt={c.conchasAlt} width="300" height="329" loading="lazy" decoding="async" />
          </picture>
          <figcaption>Conchas</figcaption>
        </figure>
        <figure>
          <picture>
            <source srcset="/images/original/artimex-empanadas.webp" type="image/webp" />
            <img src="/images/original/artimex-empanadas.jpg" alt={c.empanadasAlt} width="300" height="329" loading="lazy" decoding="async" />
          </picture>
          <figcaption>Empanadas</figcaption>
        </figure>
      </div>
    </div>
    <ol class="about-craft-list">
      {c.craft.map((detail, index) => <li><span aria-hidden="true">0{index + 1}</span><div><h4>{detail.title}</h4><p>{detail.text}</p></div></li>)}
    </ol>
  </div>

  {(fresh || wholesale) && <div class:list={['about-audiences', { 'single-audience': productSections.length === 1 }]}>
    {fresh && <article class="about-audience about-at-home">
      <p class="eyebrow">{c.fresh.eyebrow}</p>
      <h3>{c.fresh.title}</h3>
      <p class="about-audience-lead">{c.fresh.introduction}</p>
      <dl>{c.fresh.details.map(detail => <div><dt>{detail.title}</dt><dd>{detail.text}</dd></div>)}</dl>
      <a class="about-link" href={`#${fresh.anchor}`}>{c.fresh.link}<span aria-hidden="true">↗</span></a>
    </article>}
    {wholesale && <article class="about-audience about-for-business">
      <p class="eyebrow">{c.wholesale.eyebrow}</p>
      <h3>{c.wholesale.title}</h3>
      <p class="about-audience-lead">{c.wholesale.introduction}</p>
      <dl>{c.wholesale.details.map(detail => <div><dt>{detail.title}</dt><dd>{detail.text}</dd></div>)}</dl>
      <div class="about-actions">
        <a class="about-link" href={`#${wholesale.anchor}`}>{c.wholesale.link}<span aria-hidden="true">↗</span></a>
        <a class="about-contact" href="#contact">{c.wholesale.contact}<span aria-hidden="true">→</span></a>
      </div>
    </article>}
  </div>}
</section>

<style>
  .about-section { background: var(--cream-2); }
  .about-intro { display: grid; grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr); }
  .about-opening { min-width: 0; grid-column: 2; padding: clamp(68px, 6.5vw, 110px) 6vw; }
  h2, h3, h4 { margin: 0; font-family: var(--serif); font-weight: 400; }
  h2 { font-size: clamp(52px, 5vw, 88px); letter-spacing: -.055em; line-height: .98; text-wrap: balance; }
  h2 em { display: block; margin-top: 6px; color: var(--orange-deep); }
  .about-lead { max-width: 630px; margin: 30px 0 0; color: #44352b; font-size: 16px; line-height: 1.75; }
  .about-origin { max-width: 630px; margin-top: 34px; padding-top: 26px; border-top: 1px solid var(--line); }
  .about-origin .eyebrow { margin-bottom: 12px; font-size: 9px; }
  .about-origin h3 { font-size: clamp(25px, 2.2vw, 34px); letter-spacing: -.03em; line-height: 1.2; }
  .about-origin > p:last-child { margin: 14px 0 0; color: #5b493c; font-size: 14px; line-height: 1.75; }
  .about-principles { margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 20px; list-style: none; }
  .about-principles li { display: flex; align-items: center; gap: 9px; color: var(--orange-deep); font-size: 10px; font-weight: 800; }
  .about-principles li::before { content: ''; width: 5px; height: 5px; background: currentColor; transform: rotate(45deg); }
  .about-portrait { min-width: 0; min-height: 700px; margin: 0; padding: clamp(32px, 4vw, 72px); grid-column: 1; grid-row: 1; display: grid; grid-template-rows: 1fr auto; gap: 24px; background: #811428; }
  .about-portrait picture { min-height: 0; position: relative; display: block; overflow: hidden; }
  .about-portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
  .about-portrait figcaption { max-width: 390px; padding-left: 20px; border-left: 1px solid #dda547; color: var(--cream); font-family: var(--serif); font-size: clamp(21px, 1.8vw, 29px); font-style: italic; line-height: 1.25; text-wrap: balance; }
  .about-standard { padding: clamp(72px, 7vw, 116px) 6vw; display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 8vw; background: var(--paper); }
  .about-standard h3 { max-width: 550px; font-size: clamp(42px, 4.2vw, 68px); letter-spacing: -.045em; line-height: 1.05; text-wrap: balance; }
  .about-archive { max-width: 530px; margin-top: 40px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .about-archive figure { min-width: 0; margin: 0; }
  .about-archive figure:last-child { margin-top: 34px; }
  .about-archive picture { display: block; aspect-ratio: 300 / 329; overflow: hidden; background: var(--cream-2); }
  .about-archive img { width: 100%; height: 100%; object-fit: cover; }
  .about-archive figcaption { margin-top: 12px; color: #655448; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
  .about-craft-list { margin: 0; padding: 0; list-style: none; align-self: center; border-top: 1px solid var(--line); }
  .about-craft-list li { padding: 30px 0; display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 22px; border-bottom: 1px solid var(--line); }
  .about-craft-list li > span { padding-top: 7px; color: var(--orange-deep); font-size: 10px; font-weight: 800; }
  .about-craft-list h4 { font-size: clamp(25px, 2.4vw, 34px); letter-spacing: -.025em; line-height: 1.2; }
  .about-craft-list p { max-width: 540px; margin: 14px 0 0; color: #655448; font-size: 15px; line-height: 1.75; }
  .about-audiences { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .about-audiences.single-audience { grid-template-columns: minmax(0, 1fr); }
  .about-audience { min-width: 0; padding: clamp(64px, 6vw, 100px) 6vw; }
  .about-audience h3 { font-size: clamp(42px, 4.3vw, 70px); letter-spacing: -.045em; line-height: 1.05; }
  .about-audience-lead { max-width: 620px; margin: 25px 0 0; color: #5b493c; font-size: 15px; line-height: 1.75; }
  .about-audience dl { max-width: 620px; margin: 30px 0 0; border-top: 1px solid var(--line); }
  .about-audience dl > div { padding: 18px 0; display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 24px; border-bottom: 1px solid var(--line); }
  .about-audience dt { font-family: var(--serif); font-size: 20px; line-height: 1.25; }
  .about-audience dd { margin: 0; color: #655448; font-size: 13px; line-height: 1.65; }
  .about-for-business { background: #811428; color: var(--cream); }
  .about-for-business .eyebrow { color: #efbc62; }
  .about-for-business .about-audience-lead, .about-for-business dd { color: #ead9cf; }
  .about-for-business dl, .about-for-business dl > div { border-color: rgba(244,236,220,.23); }
  .about-actions { display: flex; align-items: baseline; flex-wrap: wrap; gap: 24px 30px; }
  .about-link { width: fit-content; min-height: 44px; margin-top: 32px; padding-bottom: 10px; border-bottom: 1px solid currentColor; display: inline-flex; align-items: center; gap: 24px; color: var(--orange-deep); font-size: 10px; font-weight: 900; letter-spacing: .1em; line-height: 1.5; text-transform: uppercase; }
  .about-link span { font-size: 17px; }
  .about-for-business .about-link { color: var(--cream); }
  .about-contact { min-height: 44px; display: inline-flex; align-items: center; gap: 14px; color: #ead9cf; font-size: 12px; }
  .about-contact:hover { text-decoration: underline; text-underline-offset: 5px; }
  .about-for-business a:focus-visible { outline-color: #efbc62; }
  @media (max-width: 1100px) {
    .about-opening { padding: 70px 5vw; }
    h2 { font-size: clamp(48px, 5.4vw, 66px); }
    .about-portrait { padding: 32px; }
    .about-standard { gap: 5vw; }
    .about-audience { padding-right: 5vw; padding-left: 5vw; }
    .about-audience dl > div { grid-template-columns: minmax(0, 1fr); gap: 7px; }
  }
  @media (max-width: 900px) {
    .about-intro { grid-template-columns: minmax(0, 1fr); }
    .about-opening { grid-column: auto; padding: 76px 7vw; }
    h2 { max-width: 650px; font-size: clamp(54px, 7.8vw, 76px); }
    .about-portrait { min-height: 0; grid-column: auto; grid-row: auto; padding: 40px 7vw; }
    .about-portrait picture { aspect-ratio: 4 / 3; }
    .about-standard { grid-template-columns: minmax(0, 1fr); gap: 50px; padding-right: 7vw; padding-left: 7vw; }
    .about-standard-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0 30px; align-content: start; }
    .about-standard-intro .eyebrow { grid-column: 1; }
    .about-standard-intro h3 { grid-column: 1; align-self: start; }
    .about-archive { grid-column: 2; grid-row: 1 / 3; margin-top: 0; gap: 12px; }
    .about-craft-list li { padding: 27px 0; }
    .about-craft-list p { max-width: none; }
    .about-audiences { grid-template-columns: minmax(0, 1fr); }
    .about-audience { padding: 70px 7vw; }
    .about-audience dl > div { grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 24px; }
  }
  @media (max-width: 560px) {
    .about-opening { padding: 64px 22px; }
    h2 { font-size: clamp(44px, 11.8vw, 62px); }
    .about-lead { font-size: 15px; }
    .about-principles { column-gap: 17px; }
    .about-portrait { padding: 24px; }
    .about-portrait picture { aspect-ratio: 4 / 5; }
    .about-portrait figcaption { font-size: 23px; }
    .about-standard { padding: 64px 22px; gap: 40px; }
    .about-standard-intro { display: block; }
    .about-standard h3 { font-size: clamp(40px, 10.5vw, 56px); }
    .about-archive { margin-top: 30px; gap: 14px; }
    .about-archive figure:last-child { margin-top: 24px; }
    .about-craft-list li { grid-template-columns: 23px minmax(0, 1fr); gap: 13px; }
    .about-craft-list h4 { font-size: 26px; }
    .about-craft-list p { font-size: 14px; }
    .about-audience { padding: 64px 22px; }
    .about-audience h3 { font-size: clamp(40px, 10.5vw, 56px); }
    .about-audience dl > div { grid-template-columns: minmax(0, 1fr); gap: 7px; }
  }
</style>
