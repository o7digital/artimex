} : {
  eyebrow: 'From freezer to bakery case',
  title: 'A simpler path to', titleEm: 'a better bake.',
  intro: 'A great bakery case starts before the oven turns on. Organize your stock, prepare each product for its format and bake around your customers. Give every batch a purpose.',
  explore: 'Explore the four stages',
  photoAlt: 'Conchas, empanadas and Mexican breads arranged on a bakery table',
  photoEyebrow: 'Craft in every batch',
  photoTitle: 'Tradition in the bread.', photoEm: 'Purpose in the process.',
  payoff: 'What it means for your business',
  formatsEyebrow: 'Know your product', formatsTitle: 'Two formats.', formatsEm: 'The right preparation.',
  formatsIntro: 'Frozen dough and fully baked bread take different paths. Choose the format that fits your team, your space and your service.',
  specification: 'Each product specification sets its preparation method, times and temperatures.',
  questionsEyebrow: 'Before your first batch', questionsTitle: 'Questions from your team.',
  ctaEyebrow: 'Let’s plan for your business', ctaTitle: 'Your assortment. Your rhythm.', ctaEm: 'Our bread.',
  ctaText: 'Tell us what you serve, when your customers arrive and which equipment you have. Let’s talk about the selection and format that make sense for your operation.',
  cta: 'Plan my bakery program', subject: 'Artimex bakery program',
  steps: [
    {
      label: 'Stock', preview: 'An assortment with a plan', tag: 'Inventory & planning',
      title: 'Have what you need.', emphasis: 'When you need it.',
      description: 'Build an assortment around your busiest moments, from morning coffee to take-home purchases. Keep products in their specified storage conditions and pull only what you plan to prepare.',
      checks: [
        ['Plan around service', 'Review sales by product and time of day to decide what to prepare first and what to keep in reserve.'],
        ['Make each batch easy to find', 'Identify the product, date and lot. Organize stock rotation so your team can find the right inventory easily.'],
        ['Separate reserve from production', 'Set the quantity for the next batch and store the remaining inventory according to the product instructions.'],
      ],
      benefit: 'A more organized assortment and production decisions informed by demand in your business.',
    },
    {
      label: 'Prepare', preview: 'The right path for each format', tag: 'Preparation & coordination',
      title: 'Give every bread', emphasis: 'its own process.',
      description: 'Preparation depends on the product: frozen dough may require thawing and proofing, while fully baked items follow a different sequence. Check the product specification before scheduling production.',
      checks: [
        ['Confirm the format', 'Distinguish frozen dough from fully baked products and check the preparation method for the item you plan to serve.'],
        ['Set up your space and equipment', 'Organize trays, oven space and proofing equipment where required. Consider available capacity before starting.'],
        ['Coordinate the next batch', 'Assign who prepares each item and when it needs to be ready for the oven, following its product specification.'],
      ],
      benefit: 'A clear sequence for your team, with less last-minute improvisation before service.',
    },
    {
      label: 'Bake', preview: 'Quality in every batch', tag: 'Baking & finishing',
      title: 'Bake with care.', emphasis: 'Repeat with confidence.',
      description: 'Turn your preparation into a batch that looks, smells and tastes the way it should. Follow the product instructions and document the result with your equipment to give your team a shared quality reference.',
      checks: [
        ['Start with the specification', 'Prepare the oven and follow the recommended times, temperatures and oven load for each product.'],
        ['Check the complete result', 'Review color, shape and texture alongside the specified baking checks. Appearance alone does not replace the product’s preparation process.'],
        ['Get the finish right', 'Follow cooling, finishing or packaging instructions before moving the bread to the bakery case or serving it.'],
      ],
      benefit: 'A finishing standard your team can recognize and reproduce from one batch to the next.',
    },
    {
      label: 'Sell', preview: 'A bakery case that keeps moving', tag: 'Presentation & replenishment',
      title: 'Display to tempt.', emphasis: 'Replenish to sell.',
      description: 'Make your assortment easy to discover and choose. Pair sweet and savory breads around your customers, keep product information clear and base the next batch on what is actually selling.',
      checks: [
        ['Tell customers what’s in the case', 'Present names and flavors clearly. Keep the product’s ingredient and allergen information available to your team and customers.'],
        ['Create a reason to enjoy it', 'Suggest conchas with coffee, bolillos or teleras for tortas and empanadas to go, using the products in your assortment.'],
        ['Learn from every service', 'Track sales, leftovers and sellouts. Use that information to adjust the variety and size of your next batch.'],
      ],
      benefit: 'A clearer bakery case for your customers and a replenishment cycle that learns from your sales.',
    },
  ],
  formats: [
    { label: '01 / Frozen dough', title: 'Prepare. Proof. Bake.', text: 'For an operation that includes dough preparation. Plan for the space, equipment and lead time each item needs before baking.', route: ['Thaw as directed', 'Proof if required', 'Bake'], image: '/images/products/Concha-Blanco-color.webp', width: 638, height: 572, alt: 'Vanilla concha with a traditional shell topping' },
    { label: '02 / Fully baked', title: 'Finish. Display. Replenish.', text: 'For service built around an already baked product. Follow its thawing or oven-finishing instructions and focus on presentation and replenishment.', route: ['Thaw as directed', 'Finish if required', 'Display'], image: '/images/products/Bolillo-color.webp', width: 746, height: 514, alt: 'Mexican bolillo with a golden crust' },
  ],
  questions: [
    ['Does every product need proofing?', 'Each product follows its own process. Check whether your selection is frozen dough or fully baked, then follow its product specification. Confirm the preparation requirements for your assortment with the sales team.'],
    ['How do I choose the size of each batch?', 'Start with sales by time of day and product. Compare what you prepared with what sold, record sellouts and leftovers, then adjust the next batch. Your busiest hours help you plan replenishment.'],
    ['What do I need to choose a program?', 'Share your type of business, the products you want to serve, your storage capacity and available preparation equipment. These details help you discuss assortment, formats and the requirements for each product.'],
  ],
};
---

<section class="bake-process" id="bake-process" aria-labelledby="bake-process-title" data-bake-process>
  <div class="process-heading">
    <div><p class="eyebrow">{copy.eyebrow}</p><h2 id="bake-process-title">{copy.title}<em>{copy.titleEm}</em></h2></div>
    <p class="process-intro">{copy.intro}</p>
  </div>

  <div class="stage-tabs" aria-label={copy.explore} data-stage-tabs hidden>
    {copy.steps.map((step, index) => (
      <button type="button" id={`stage-tab-${index}`} aria-controls={`stage-panel-${index}`} data-stage-tab>
        <span class="tab-number">0{index + 1}</span>
        <span class="tab-copy"><strong>{step.label}</strong><small>{step.preview}</small></span>
        <span class="tab-arrow" aria-hidden="true">↗</span>
      </button>
    ))}
  </div>

  <div class="process-workspace">
    <figure class="process-photo">
      <img src="/images/hero-premium-900.webp" alt={copy.photoAlt} width="900" height="600" loading="lazy" decoding="async" />
      <div class="photo-stage" aria-hidden="true"><span data-stage-number>01</span><span>/ 04</span></div>
      <figcaption><p>{copy.photoEyebrow}</p><strong>{copy.photoTitle}<em>{copy.photoEm}</em></strong></figcaption>
    </figure>
    <div class="stage-panels">
      {copy.steps.map((step, index) => (
        <article class="stage-panel" id={`stage-panel-${index}`} data-stage-panel>
          <p class="stage-tag"><span aria-hidden="true">0{index + 1}</span>{step.tag}</p>
          <h3>{step.title}<em>{step.emphasis}</em></h3>
          <p class="stage-description">{step.description}</p>
          <ul class="stage-checks">{step.checks.map(([title, text]) => <li><span aria-hidden="true">✓</span><div><h4>{title}</h4><p>{text}</p></div></li>)}</ul>
          <div class="stage-benefit"><p>{copy.payoff}</p><strong>{step.benefit}</strong></div>
        </article>
      ))}
    </div>
  </div>

  <div class="format-heading"><div><p class="eyebrow">{copy.formatsEyebrow}</p><h3>{copy.formatsTitle}<em>{copy.formatsEm}</em></h3></div><p>{copy.formatsIntro}</p></div>
  <div class="format-grid">
    {copy.formats.map(format => (
      <article class="format-card">
        <div class="format-copy"><p class="format-label">{format.label}</p><h4>{format.title}</h4><p>{format.text}</p></div>
        <img src={format.image} alt={format.alt} width={format.width} height={format.height} loading="lazy" decoding="async" />
        <ol class="format-route">{format.route.map((label, index) => <li>{index > 0 && <span aria-hidden="true">→</span>}{label}</li>)}</ol>
      </article>
    ))}
  </div>
  <p class="product-specification"><span aria-hidden="true">↳</span>{copy.specification}</p>

  <div class="process-questions">
    <div><p class="eyebrow">{copy.questionsEyebrow}</p><h3>{copy.questionsTitle}</h3></div>
    <div class="questions-list">{copy.questions.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div>
  </div>

  <div class="process-cta">
    <div><p class="eyebrow">{copy.ctaEyebrow}</p><h3>{copy.ctaTitle}<em>{copy.ctaEm}</em></h3></div>
    <div><p>{copy.ctaText}</p><a class="button button-primary" href={`mailto:sales@artimex.com?subject=${encodeURIComponent(copy.subject)}`}>{copy.cta}<span aria-hidden="true">↗</span></a></div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-bake-process]').forEach(root => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-panel]'));
    const tabList = root.querySelector<HTMLElement>('[data-stage-tabs]');
    const stageNumber = root.querySelector<HTMLElement>('[data-stage-number]');
    if (!tabList || tabs.length !== panels.length) return;

    const activate = (index: number, focus = false) => {
      tabs.forEach((tab, current) => {
        const selected = index === current;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[current].hidden = !selected;
      });
      if (stageNumber) stageNumber.textContent = String(index + 1).padStart(2, '0');
      if (focus) tabs[index].focus();
    };

    tabList.setAttribute('role', 'tablist');
    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      panels[index].setAttribute('role', 'tabpanel');
      panels[index].setAttribute('aria-labelledby', tab.id);
      panels[index].tabIndex = 0;
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(next, true);
      });
    });
    activate(0);
    tabList.hidden = false;
  });
</script>

<style>
  .bake-process { padding: 100px 6vw; background: var(--paper); }
  .process-heading { display: grid; grid-template-columns: 1.25fr .75fr; gap: 6vw; align-items: end; margin-bottom: 48px; }
  .process-heading h2 { margin: 0; font-family: var(--serif); font-size: clamp(52px, 5.4vw, 90px); font-weight: 400; line-height: .98; letter-spacing: -.055em; }
  h2 em, h3 em { display: block; }
  .process-intro { max-width: 470px; margin: 0 0 5px; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .stage-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--line); }
  .stage-tabs[hidden], .stage-panel[hidden] { display: none; }
  .stage-tabs button { display: flex; align-items: center; gap: 18px; min-height: 110px; padding: 24px; border: 0; border-right: 1px solid var(--line); background: transparent; text-align: left; cursor: pointer; transition: background .2s, color .2s; }
  .stage-tabs button:last-child { border-right: 0; }
  .stage-tabs button:hover { background: var(--cream); }
  .stage-tabs button[aria-selected="true"] { background: #811428; color: var(--paper); }
  .stage-tabs button:focus-visible { position: relative; outline: 2px solid var(--gold); outline-offset: -5px; }
  .tab-number { color: var(--orange); font-family: var(--serif); font-style: italic; font-size: 28px; }
  [aria-selected="true"] .tab-number { color: #efbc62; }
  .tab-copy { display: flex; flex: 1; flex-direction: column; gap: 8px; }
  .tab-copy strong { font-family: var(--serif); font-size: 27px; font-weight: 400; }
  .tab-copy small { color: var(--muted); font-size: 10px; line-height: 1.5; }
  [aria-selected="true"] .tab-copy small { color: #ead9c7; }
  .tab-arrow { font-size: 19px; }
  .process-workspace { display: grid; grid-template-columns: .85fr 1.15fr; border: 1px solid var(--line); border-top: 0; }
  .process-photo { position: relative; min-height: 670px; margin: 0; overflow: hidden; background: #201610; }
  .process-photo > img { position: absolute; width: 100%; height: 100%; object-fit: cover; object-position: 64% center; }
  .process-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(24,14,9,.2), transparent 35%, rgba(24,14,9,.9)); }
  .photo-stage { position: absolute; top: 30px; left: 30px; z-index: 1; display: flex; align-items: baseline; gap: 9px; color: var(--paper); }
  .photo-stage span:first-child { font-family: var(--serif); font-style: italic; font-size: 58px; }
  .photo-stage span:last-child { color: #ead9c7; font-size: 11px; letter-spacing: .1em; }
  figcaption { position: absolute; z-index: 1; right: 34px; bottom: 38px; left: 34px; color: var(--paper); }
  figcaption p { margin: 0 0 16px; color: #efbc62; font-size: 9px; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
  figcaption strong { font-family: var(--serif); font-size: clamp(34px, 3.3vw, 52px); font-weight: 400; line-height: 1.05; letter-spacing: -.035em; }
  figcaption em { display: block; color: #efbc62; }
  .stage-panel { padding: 38px 42px; }
  .stage-panel + .stage-panel { border-top: 1px solid var(--line); }
  .stage-tag { display: flex; align-items: center; gap: 12px; margin: 0 0 20px; color: var(--orange); font-size: 9px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .stage-tag span { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid var(--orange); border-radius: 50%; font-size: 9px; letter-spacing: 0; }
  .stage-panel h3 { margin: 0 0 20px; font-family: var(--serif); font-size: clamp(33px, 3.2vw, 52px); font-weight: 400; line-height: 1.06; letter-spacing: -.035em; }
  .stage-description { margin: 0 0 25px; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .stage-checks { display: grid; gap: 19px; margin: 0; padding: 0; list-style: none; }
  .stage-checks li { display: grid; grid-template-columns: 24px 1fr; gap: 11px; }
  .stage-checks li > span { display: grid; place-items: center; width: 22px; height: 22px; margin-top: 1px; border: 1px solid #dacba9; border-radius: 50%; color: #811428; font-size: 11px; }
  .stage-checks h4 { margin: 0 0 5px; font-size: 12px; line-height: 1.5; }
  .stage-checks p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
  .stage-benefit { margin-top: 26px; padding: 19px 21px; border-left: 3px solid var(--gold); background: #f0e7d5; }
  .stage-benefit p { margin: 0 0 8px; color: #811428; font-size: 8px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .stage-benefit strong { display: block; font-family: var(--serif); font-size: 17px; font-weight: 400; line-height: 1.45; }
  .format-heading { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 5vw; margin: 70px 0 30px; }
  .format-heading h3, .process-questions h3 { margin: 0; font-family: var(--serif); font-size: clamp(32px, 3.3vw, 52px); font-weight: 400; line-height: 1.06; letter-spacing: -.035em; }
  .format-heading > p { max-width: 490px; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.75; }
  .format-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .format-card { display: grid; grid-template-columns: minmax(0, 1fr) 115px; column-gap: 20px; padding: 30px; background: #f2ecdf; border: 1px solid var(--line); }
  .format-label { margin: 0 0 17px; color: #811428; font-size: 9px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .format-copy h4 { margin: 0 0 14px; font-family: var(--serif); font-size: 28px; font-weight: 400; line-height: 1.15; letter-spacing: -.025em; }
  .format-copy > p:last-child { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
  .format-card > img { align-self: center; width: 115px; height: 120px; object-fit: contain; mix-blend-mode: multiply; }
