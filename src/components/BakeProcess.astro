---
interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;
const es = lang === 'es';

const copy = es ? {
  eyebrow: 'Del congelador a la vitrina',
  title: 'Un camino más simple hacia', titleEm: 'un mejor horneado.',
  intro: 'Una buena vitrina empieza antes de encender el horno. Organiza tu inventario, prepara cada producto según su formato y hornea al ritmo de tus clientes. Así, cada tanda tiene un propósito.',
  explore: 'Explora las cuatro etapas',
  photoAlt: 'Surtido de conchas, empanadas y panes mexicanos sobre una mesa de panadería',
  photoEyebrow: 'El oficio, en cada tanda',
  photoTitle: 'Tradición en el pan.', photoEm: 'Intención en el proceso.',
  payoff: 'El valor para tu negocio',
  formatsEyebrow: 'Conoce tu producto', formatsTitle: 'Dos formatos.', formatsEm: 'La preparación correcta.',
  formatsIntro: 'La masa congelada y el pan ya horneado tienen recorridos distintos. Elige el formato que se adapte a tu equipo, tu espacio y tu servicio.',
  specification: 'La ficha de cada producto define su método de preparación, los tiempos y las temperaturas.',
  questionsEyebrow: 'Antes de tu primera tanda', questionsTitle: 'Preguntas de tu equipo.',
  ctaEyebrow: 'Hagamos un plan para tu negocio', ctaTitle: 'Tu surtido. Tu ritmo.', ctaEm: 'Nuestro pan.',
  ctaText: 'Cuéntanos qué sirves, cuándo llegan tus clientes y con qué equipo cuentas. Hablemos de la selección y el formato que tienen sentido para tu operación.',
  cta: 'Planear mi programa de panadería', subject: 'Programa de panadería Artimex',
  steps: [
    {
      label: 'Almacena', preview: 'Un inventario con intención', tag: 'Inventario y planeación',
