---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from './BrandLogo.astro';
import SiteFooter from './SiteFooter.astro';
import { privacyNotice } from '../data/privacyNotice.js';

interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;
const es = lang === 'es';
const copy = privacyNotice[lang];
const home = es ? '/es/' : '/';
const other = es ? '/privacy-notice/' : '/es/aviso-de-privacidad/';
const requestLink = `mailto:sales@artimex.com?subject=${encodeURIComponent(copy.requestSubject)}`;
---
<BaseLayout title={`${copy.title} — Artimex Bakery`} description={copy.description} lang={lang} alternatePaths={{ en: '/privacy-notice/', es: '/es/aviso-de-privacidad/' }}>
  <div class="site-shell">
    <a class="skip-link" href="#privacy-content">{es ? 'Ir al aviso' : 'Skip to notice'}</a>
    <header class="privacy-header"><a class="brand" href={home}><BrandLogo compact /></a><nav aria-label={es ? 'Navegación del aviso' : 'Notice navigation'}><a class="return-home" href={home}><span aria-hidden="true">←</span>{copy.home}</a><a class="language-link" href={other} hreflang={es ? 'en' : 'es'} lang={es ? 'en' : 'es'} aria-label={es ? 'Read in English' : 'Leer en español'}>{es ? 'EN' : 'ES'}</a></nav></header>
    <main id="privacy-content">
      <div class="privacy-hero"><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.titleLead}<em>{copy.titleEm}</em></h1><p class="privacy-intro">{copy.intro}</p><p class="notice-date"><time datetime={privacyNotice.updated}>{copy.updated}</time></p></div>
      <aside class="notice-summary" aria-labelledby="summary-title"><h2 id="summary-title">{copy.summaryTitle}</h2><dl>{copy.summary.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></aside>
      <div class="privacy-layout">
        <aside class="privacy-sidebar">
          <nav aria-label={copy.contents}><p>{copy.contents}</p><ol>{copy.sections.map((section, index) => <li><a href={`#${section.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{section.title}</a></li>)}</ol></nav>
          <div class="sidebar-contact"><p>{copy.contact}</p><a href="mailto:sales@artimex.com">sales@artimex.com</a><a href="tel:+15627770924">562-777-0924</a></div>
        </aside>
        <div class="legal-content">
          {copy.sections.map((section, index) => (
            <section id={section.id} aria-labelledby={`${section.id}-title`}>
              <p class="section-number">{String(index + 1).padStart(2, '0')}</p><h2 id={`${section.id}-title`}>{section.title}</h2>
              {section.paragraphs?.map(text => <p>{text}</p>)}
              {section.bullets && <ul>{section.bullets.map(text => <li>{text}</li>)}</ul>}
              {section.id === 'information' && <div class="information-categories"><h3>{copy.categoriesTitle}</h3><dl>{copy.categories.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></div>}
              {section.closing?.map(text => <p>{text}</p>)}
              {section.links && <div class="resource-links">{section.links.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true">↗</span></a>)}</div>}
              {section.id === 'privacy-rights' && <a class="button button-primary request-button" href={requestLink}>{copy.request}<span aria-hidden="true">↗</span></a>}
            </section>
          ))}
          <aside class="privacy-contact" aria-labelledby="privacy-contact-title"><p class="eyebrow">Artimex Bakery</p><h2 id="privacy-contact-title">{copy.contact}</h2><p class="contact-department">{copy.department}</p><address>12764 Florence Avenue<br />Santa Fe Springs, CA 90670<br />{es ? 'Estados Unidos' : 'United States'}</address><dl><div><dt>Email</dt><dd><a href="mailto:sales@artimex.com">sales@artimex.com</a></dd></div><div><dt>{copy.phone}</dt><dd><a href="tel:+15627770924">562-777-0924</a></dd></div><div><dt>FAX</dt><dd>562-777-9607</dd></div></dl></aside>
        </div>
      </div>
    </main>
    <SiteFooter lang={lang} />
  </div>
</BaseLayout>

<style>
  .site-shell { background: var(--paper); }
  .skip-link { position: fixed; top: -80px; left: 20px; z-index: 200; padding: 14px 20px; background: var(--paper); color: var(--ink); }
  .skip-link:focus { top: 15px; }
  .privacy-header { display: flex; justify-content: space-between; align-items: center; gap: 25px; min-height: 102px; padding: 18px 6vw; background: #1c120e; color: var(--paper); position: sticky; top: 0; z-index: 80; }
  .privacy-header nav { display: flex; align-items: center; gap: 26px; }
  .return-home { display: inline-flex; align-items: center; gap: 12px; font-size: 12px; }
  .return-home span { color: #efbc62; font-size: 19px; }
  main { max-width: 1450px; margin: 0 auto; padding: 78px 6vw 90px; }
  .privacy-hero { max-width: 830px; }
  .privacy-hero h1 { margin: 25px 0; font-family: var(--serif); font-size: clamp(64px, 6.5vw, 96px); font-weight: 400; line-height: .92; letter-spacing: -.055em; }
  .privacy-hero h1 em { display: block; }
  .privacy-intro { max-width: 670px; margin: 0; color: var(--muted); font-family: var(--serif); font-size: 21px; line-height: 1.55; }
  .notice-date { margin: 27px 0 0; color: #7d6d5e; font-size: 11px; line-height: 1.7; }
  .notice-summary { margin: 42px 0 60px; padding: 26px 30px; border-top: 1px solid #decfb8; border-bottom: 1px solid #decfb8; background: #f3ecdf; }
  .notice-summary h2 { margin: 0 0 23px; color: #811428; font-size: 9px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .notice-summary dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 34px; margin: 0; }
  .notice-summary dt { margin-bottom: 10px; font-family: var(--serif); font-size: 23px; }
  .notice-summary dd { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }
  .privacy-layout { display: grid; grid-template-columns: 245px minmax(0, 1fr); gap: 65px; align-items: start; }
  .privacy-sidebar { position: sticky; top: 129px; }
  .privacy-sidebar nav > p, .sidebar-contact > p { margin: 0 0 20px; color: #811428; font-size: 9px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .privacy-sidebar ol { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .privacy-sidebar li a { display: grid; grid-template-columns: 23px 1fr; gap: 9px; color: #6c5d50; font-size: 11px; line-height: 1.5; }
  .privacy-sidebar li span { color: #b91f35; font-family: var(--serif); font-style: italic; }
  .privacy-sidebar li a:hover { color: #811428; }
  .sidebar-contact { margin-top: 32px; padding-top: 23px; border-top: 1px solid var(--line); }
  .sidebar-contact > p { margin-bottom: 13px; }
  .sidebar-contact > a { display: block; width: fit-content; margin-top: 8px; color: #811428; font-size: 12px; text-decoration: underline; text-underline-offset: 3px; }
  .legal-content { min-width: 0; }
  .legal-content > section { padding-bottom: 36px; margin-bottom: 35px; border-bottom: 1px solid var(--line); scroll-margin-top: 128px; }
  .section-number { margin: 0 0 11px; color: #b91f35; font-family: var(--serif); font-size: 18px; font-style: italic; }
  .legal-content h2 { margin: 0 0 23px; font-family: var(--serif); font-size: clamp(29px, 2.6vw, 37px); font-weight: 400; line-height: 1.12; letter-spacing: -.025em; }
  .legal-content section > p:not(.section-number), .legal-content li { color: #625448; font-size: 14px; line-height: 1.85; }
  .legal-content section > p:not(.section-number) { margin: 16px 0 0; }
  .legal-content ul { display: grid; gap: 11px; padding-left: 19px; margin: 21px 0; }
  .legal-content li::marker { color: #b91f35; }
  .information-categories { margin-top: 27px; padding: 25px; background: #f3ecdf; border-left: 2px solid #dda547; }
  .information-categories h3 { margin: 0 0 20px; color: #811428; font-size: 10px; line-height: 1.6; letter-spacing: .07em; text-transform: uppercase; }
  .information-categories dl { display: grid; gap: 20px; margin: 0; }
  .information-categories dt { margin-bottom: 6px; color: var(--ink); font-size: 12px; font-weight: 750; line-height: 1.5; }
  .information-categories dd { margin: 0; color: #625448; font-size: 12px; line-height: 1.85; }
  .resource-links { display: flex; flex-wrap: wrap; gap: 12px 25px; margin-top: 23px; }
  .resource-links a { display: inline-flex; align-items: baseline; gap: 8px; color: #811428; font-size: 11px; line-height: 1.7; text-decoration: underline; text-underline-offset: 4px; }
  .request-button { margin-top: 26px; white-space: normal; line-height: 1.5; }
  .privacy-contact { padding: 32px; background: #201610; color: var(--paper); }
  .privacy-contact .eyebrow { color: #efbc62; }
  .privacy-contact h2 { margin-bottom: 20px; }
  .privacy-contact .contact-department { margin: 0 0 12px; font-size: 13px; font-weight: 650; line-height: 1.6; }
  .privacy-contact address { margin-bottom: 25px; color: #d5c6b5; font-size: 13px; font-style: normal; line-height: 1.8; }
  .privacy-contact dl { display: grid; gap: 9px; margin: 0; }
  .privacy-contact dl > div { display: grid; grid-template-columns: 68px 1fr; gap: 12px; font-size: 13px; line-height: 1.6; }
  .privacy-contact dt { color: #efbc62; }
  .privacy-contact dd { margin: 0; }
  .privacy-contact a { text-decoration: underline; text-underline-offset: 3px; }
  #privacy-content { scroll-margin-top: 120px; }
  @media (max-width: 1000px) { .privacy-layout { grid-template-columns: 200px minmax(0, 1fr); gap: 35px; } .privacy-sidebar li a { font-size: 10px; } }
  @media (max-width: 820px) {
    .privacy-header { padding: 15px 22px; }
    main { padding: 55px 24px 65px; }
    .privacy-layout { grid-template-columns: 1fr; gap: 40px; }
    .privacy-sidebar { position: static; padding-bottom: 30px; border-bottom: 1px solid var(--line); }
    .privacy-sidebar ol { grid-template-columns: 1fr 1fr; gap: 14px 23px; }
    .privacy-sidebar li a { font-size: 11px; }
    .sidebar-contact { display: none; }
    .notice-summary { margin-bottom: 35px; padding: 25px; }
    .notice-summary dl { grid-template-columns: 1fr; gap: 20px; }
    .notice-summary dt { margin-bottom: 6px; font-size: 21px; }
  }
  @media (max-width: 560px) {
    .privacy-header { gap: 15px; min-height: 88px; padding: 12px 20px; }
    .privacy-header nav { gap: 12px; }
    .return-home { font-size: 0; gap: 0; }
    .return-home span { font-size: 22px; }
    .return-home::after { content: ''; }
    .privacy-header .brand { min-width: 0; }
    .privacy-header .brand :global(.official-brand.compact) { width: 180px; height: 53px; }
    .privacy-header .brand :global(.official-brand.compact img) { width: 372px; left: -194px; }
    .privacy-hero h1 { font-size: 64px; }
    .privacy-intro { font-size: 19px; }
    .privacy-sidebar ol { grid-template-columns: 1fr; }
    .legal-content section > p:not(.section-number), .legal-content li { font-size: 13px; }
    .information-categories { padding: 20px; }
    .privacy-contact { padding: 25px; }
    .privacy-contact dl > div { grid-template-columns: 58px 1fr; gap: 8px; font-size: 12px; }
    .request-button { width: 100%; justify-content: space-between; font-size: 9px; }
  }
</style>
