---
import BrandLogo from './BrandLogo.astro';
import type { Lang } from '../data/site';

interface Props { lang: Lang; alternatePath: string; }
const { lang, alternatePath } = Astro.props;
const es = lang === 'es';
const home = es ? '/es/' : '/';
const nav = es ? [
  ['Inicio', '/es/'], ['Acerca de Artimex', '/es/acerca-de-artimex'], ['Productos', '/es/productos'],
  ['Mayoreo', '/es/mayoreo'], ['Venta al público', '/es/venta-al-publico'], ['Empleo', '/es/empleo'], ['Contacto', '/es/contacto']
] : [
  ['Home', '/'], ['About Artimex', '/about'], ['Products', '/products'], ['Wholesale', '/wholesale'],
  ['Retail', '/retail'], ['Careers', '/careers'], ['Contact', '/contact']
];
const orderPath = es ? '/es/venta-al-publico/ordenar' : '/retail/order-online';
---
<div class="announcement"><span>{es ? 'Panadería mexicana auténtica • Sur de California' : 'Authentic Mexican bakery • Southern California'}</span><a href={es ? '/es/mayoreo' : '/wholesale'}>{es ? 'Mayoreo congelado' : 'Frozen wholesale'} <span>↗</span></a></div>
<header class="header" data-header>
  <a class="brand" href={home} aria-label={es ? 'Inicio Artimex' : 'Artimex home'}><BrandLogo /></a>
  <nav class="nav" aria-label={es ? 'Navegación principal' : 'Main navigation'}>{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
  <div class="header-actions"><a class="language-link" href={alternatePath} hreflang={es ? 'en' : 'es'}>{es ? 'EN' : 'ES'}</a><a class="header-cta" href={orderPath}>{es ? 'Ordenar en línea' : 'Order online'} <span>↗</span></a></div>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={es ? 'Menú' : 'Menu'}><span></span><span></span><span></span></button>
  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu-top"><a class="brand" href={home}><BrandLogo /></a><button class="menu-close" type="button" aria-label={es ? 'Cerrar' : 'Close'}>×</button></div>
    <nav aria-label={es ? 'Navegación móvil' : 'Mobile navigation'}>{nav.map(([label, href], index) => <a href={href}><span>0{index + 1}</span>{label}</a>)}<a href={orderPath}><span>08</span>{es ? 'Ordenar en línea' : 'Order online'}</a></nav>
    <div class="mobile-menu-foot"><a href={alternatePath}>{es ? 'View in English' : 'Ver en español'}</a><a href="mailto:sales@artimex.com">sales@artimex.com</a></div>
  </div>
</header>
<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('.mobile-menu');
  const close = document.querySelector('.menu-close');
  const setOpen = (open: boolean) => {
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') setOpen(false); });
</script>
