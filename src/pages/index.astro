---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShopExperience from '../components/ShopExperience.jsx';
---
<BaseLayout title="Artimex — Artisan Mexican Bakery">
  <div class="site-shell" id="top">
    <div class="announcement">
      <span>Authentic Mexican bakery • Southern California</span>
      <a href="#wholesale">Wholesale & foodservice <span>↗</span></a>
    </div>

    <header class="header" data-header>
      <a class="brand" href="#top" aria-label="Artimex home">
        <span class="brand-mark">A</span>
        <span class="brand-copy">
          <strong>ARTIMEX</strong>
          <small>ARTISAN MEXICAN BAKERY</small>
        </span>
      </a>

      <nav class="nav" aria-label="Main navigation">
        <a href="#top">Home</a>
        <a href="#story">Our story</a>
        <a href="#fresh-products">Fresh / B2C</a>
        <a href="#frozen-products">Frozen / B2B</a>
        <a href="#shop">Products</a>
        <a href="#contact">Contact</a>
      </nav>

      <a class="header-cta" href="#shop">Shop the bakery <span>↗</span></a>

      <details class="mobile-nav">
        <summary aria-label="Open navigation">Menu</summary>
        <nav aria-label="Mobile navigation">
          <a href="#top">Home</a>
          <a href="#story">Our story</a>
          <a href="#fresh-products">Fresh / B2C</a>
          <a href="#frozen-products">Frozen / B2B</a>
          <a href="#shop">Products</a>
          <a href="#contact">Contact / Wholesale</a>
        </nav>
      </details>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow light">Authenticity • Tradition • Superior ingredients</p>
          <h1>
            Mexican baking,
            <em>made to move.</em>
          </h1>
          <p class="hero-lead">
            Artisan breads and pastries made with the flavor, texture and spirit of a real panadería — fresh for today, frozen and ready-to-bake for scale.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#shop">Shop fresh <span>↗</span></a>
            <a class="button button-ghost" href="#wholesale">Explore wholesale</a>
          </div>
          <div class="hero-meta">
            <div><strong>Fresh</strong><span>B2C bakery assortment</span></div>
            <div><strong>Frozen</strong><span>B2B ready-to-bake program</span></div>
            <div><strong>Authentic</strong><span>Mexican recipes & craft</span></div>
          </div>
        </div>

        <div class="hero-visual">
          <picture>
            <source media="(max-width: 820px)" srcset="/images/hero-premium-900.webp" type="image/webp" />
            <source srcset="/images/hero-premium.webp" type="image/webp" />
            <img src="/images/hero-premium.png" alt="Assortment of Mexican artisan breads and pastries" width="1536" height="1024" fetchpriority="high" decoding="async" />
          </picture>
          <div class="hero-badge">
            <span>01</span>
            <p>Made for the bakery case.<br />Engineered for consistency.</p>
          </div>
          <div class="hero-script">Pan hecho con corazón.</div>
        </div>
      </section>

      <section class="marquee" aria-label="Product categories">
        <div>
          <span>CONCHAS</span><i>✦</i>
          <span>EMPANADAS</span><i>✦</i>
          <span>BOLILLOS</span><i>✦</i>
          <span>CAMPECHANAS</span><i>✦</i>
          <span>PAN DULCE</span><i>✦</i>
          <span>FOODSERVICE</span><i>✦</i>
        </div>
      </section>

      <section class="shop-section section" id="shop">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Two ways to enjoy Artimex</p>
            <h2>Fresh for the table.<br /><em>Frozen for the business.</em></h2>
          </div>
          <p>
            One product philosophy, two eCommerce journeys. Customers can buy freshly prepared bakery items, while restaurants and markets can build wholesale ready-to-bake orders.
          </p>
        </div>
        <ShopExperience client:load />
      </section>

      <section class="story section" id="story">
        <div class="story-image">
          <img src="/images/concha-pink.jpg" alt="Pink Mexican concha sweet bread by Artimex Bakery" width="440" height="440" loading="lazy" decoding="async" />
          <div class="story-caption">Traditional form.<br />Modern consistency.</div>
        </div>
        <div class="story-copy">
          <p class="eyebrow">The Artimex standard</p>
          <h2>Hands. Head.<br /><em>Heart.</em></h2>
          <p class="story-lead">
            We approach Mexican baking as a craft: the right ingredients, the right fermentation, the right heat — and the discipline to make every batch worthy of the tradition behind it.
          </p>
          <div class="principles">
            <article>
              <span>01</span>
              <div><h3>Authenticity</h3><p>Classic Mexican breads with recognizable flavor, shape and texture.</p></div>
            </article>
            <article>
              <span>02</span>
              <div><h3>Consistency</h3><p>A repeatable bakery program designed for dependable daily results.</p></div>
            </article>
            <article>
              <span>03</span>
              <div><h3>Superior ingredients</h3><p>Quality starts before the oven — with a better base and careful handling.</p></div>
            </article>
          </div>
        </div>
      </section>

      <section class="wholesale" id="wholesale">
        <div class="wholesale-backdrop"></div>
        <div class="wholesale-inner">
          <p class="eyebrow light">Artimex for business</p>
          <h2>Your bakery program,<br /><em>without the bakery headache.</em></h2>
          <p class="wholesale-lead">
            Frozen, ready-to-bake products help restaurants, grocers and foodservice operators expand assortment while reducing skilled labor pressure, waste and day-to-day complexity.
          </p>

          <div class="wholesale-grid">
            <article>
              <span>01</span>
              <h3>Lower labor pressure</h3>
              <p>Serve an authentic Mexican bakery assortment without building a full scratch bakery team.</p>
            </article>
            <article>
              <span>02</span>
              <h3>Predictable output</h3>
              <p>Standardized products give your operation a more consistent bake, yield and presentation.</p>
            </article>
            <article>
              <span>03</span>
              <h3>Control waste</h3>
              <p>Bake closer to demand and keep a broader assortment available with less finished-product exposure.</p>
            </article>
          </div>

          <div class="wholesale-actions">
            <a class="button button-cream" href="mailto:sales@artimex.com?subject=Wholesale%20Artimex%20Inquiry">Request wholesale access <span>↗</span></a>
            <a class="text-link" href="#contact">Talk to sales <span>→</span></a>
          </div>
        </div>
      </section>

      <section class="process section">
        <div class="section-heading compact">
          <div>
            <p class="eyebrow">From freezer to bakery case</p>
            <h2>A simpler path to<br /><em>a better bake.</em></h2>
          </div>
        </div>
        <div class="process-track">
          <article><span>01</span><div><h3>Stock</h3><p>Keep your core assortment frozen until the operation needs it.</p></div></article>
          <article><span>02</span><div><h3>Prepare</h3><p>Follow the product-specific thaw, proof or staging process.</p></div></article>
          <article><span>03</span><div><h3>Bake</h3><p>Finish in your oven for fresh aroma, texture and bakery-case appeal.</p></div></article>
          <article><span>04</span><div><h3>Sell</h3><p>Offer authentic pan mexicano with less operational friction.</p></div></article>
        </div>
      </section>

      <section class="contact section" id="contact">
        <div class="contact-card">
          <div class="contact-copy">
            <p class="eyebrow light">Fresh bakery • Wholesale • Foodservice</p>
            <h2>Bring Artimex<br /><em>to your table.</em></h2>
            <p>For retail orders, wholesale programs, distribution questions or a custom foodservice assortment, talk with the Artimex team.</p>
          </div>
          <div class="contact-actions">
            <a href="mailto:sales@artimex.com"><small>Email sales</small><strong>sales@artimex.com</strong><span>↗</span></a>
            <a href="tel:+15627770924"><small>Call us</small><strong>562 777 0924</strong><span>↗</span></a>
            <div><small>Visit</small><strong>12764 Florence Avenue<br />Santa Fe Springs, CA 90670</strong></div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <a class="brand footer-brand" href="#top">
        <span class="brand-mark">A</span>
        <span class="brand-copy"><strong>ARTIMEX</strong><small>ARTISAN MEXICAN BAKERY</small></span>
      </a>
      <p>Authentic Mexican bread, made with craft and built for consistency.</p>
      <div class="footer-links">
        <a href="#top">Home</a>
        <a href="#story">Story</a>
        <a href="#fresh-products">Fresh</a>
        <a href="#frozen-products">Frozen</a>
        <a href="#shop">Products</a>
        <a href="#contact">Contact / Wholesale</a>
      </div>
      <small>© {new Date().getFullYear()} Artimex Artisan Mexican Bakery.</small>
    </footer>
  </div>
</BaseLayout>
